+// Madeira pipeline eviction: rebuilds an evicted pipeline state on first use.
+// Called from command encoding, possibly on several threads at once, so the rebuild is locked.
+id<MTLRenderPipelineState> MVKGraphicsPipeline::getMainPipelineState() const {
+	if ( !_isEvictedPipeline ) { return _mtlPipelineState; }
+
+	std::lock_guard<std::mutex> lock(_evictedMTLPipelineLock);
+	if ( !_mtlPipelineState && _evictedMTLPipelineDesc && !_evictedRebuildFailed ) {
+		MVKGraphicsPipeline* mutableThis = const_cast<MVKGraphicsPipeline*>(this);
+		mutableThis->getOrCompilePipeline(_evictedMTLPipelineDesc, mutableThis->_mtlPipelineState);
+		if (_mtlPipelineState) {
+			uint64_t n = ++sMadeiraRebuiltCount;
+			if (n == 1 || n % 250 == 0) {
+				fprintf(stderr, "[mvk-madeira] rebuilt %llu pipelines on use (evicted %llu)\n",
+						(unsigned long long)n, (unsigned long long)sMadeiraEvictedCount.load());
+			}
+		} else {
+			// Don't retry on every draw; the draw is skipped, as for any pipeline that failed to compile.
+			_evictedRebuildFailed = true;
+			uint64_t n = ++sMadeiraRebuildFailedCount;
+			fprintf(stderr, "[mvk-madeira] rebuild failed for an evicted pipeline (%llu failures so far)\n",
+					(unsigned long long)n);
+		}
+	}
+	return _mtlPipelineState;
+}
