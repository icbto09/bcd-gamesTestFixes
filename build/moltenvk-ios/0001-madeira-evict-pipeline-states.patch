+#pragma mark - Madeira pipeline eviction
+
+// Opt-in with the environment variable MADEIRA_MVK_EVICT_PIPELINES=1 (any value except "0").
+// Games such as Detroit: Become Human create every graphics pipeline up front and keep
+// them all alive. Each one holds a compiled MTLRenderPipelineState, so memory grows with
+// every pipeline created and never comes back. With eviction on, an ordinary graphics
+// pipeline (no tessellation, no multiview) is still fully compiled at creation, which
+// validates it and warms Metal's shader cache, but the compiled state is released at once
+// and only the descriptor is kept. The state is rebuilt the first time a draw needs it.
+static bool mvkMadeiraEvictPipelines() {
+	static const bool isEnabled = [] {
+		const char* val = getenv("MADEIRA_MVK_EVICT_PIPELINES");
+		bool enabled = val && *val && strcmp(val, "0") != 0;
+		fprintf(stderr, "[mvk-madeira] pipeline eviction %s (MADEIRA_MVK_EVICT_PIPELINES=%s)\n",
+				enabled ? "ON" : "off", val ? val : "unset");
+		return enabled;
+	}();
+	return isEnabled;
+}
+
+static std::atomic<uint64_t> sMadeiraEvictedCount(0);
+static std::atomic<uint64_t> sMadeiraRebuiltCount(0);
+static std::atomic<uint64_t> sMadeiraRebuildFailedCount(0);
+
+
