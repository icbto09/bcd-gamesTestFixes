+// Madeira: makes sure _mtlLibrary is compiled, compiling it from the stored MSL if it was
+// dropped or deferred. Returns whether a library is available. Called with _madeiraLibLock
+// held (by this library, or by the base library for a macro variant).
+bool MVKShaderLibrary::madeiraEnsureMTLLibrary() {
+	if (_mtlLibrary) { return true; }
+	if ( !_madeiraCanRecompile || _madeiraCompileFailed ) { return false; }
+
+	string msl;
+	decompressMSL(msl);
+	compileLibrary(msl, _madeiraHasMacroDef ? &_madeiraMacroDef : nullptr);
+	if ( !_mtlLibrary ) {
+		_madeiraCompileFailed = true;	// don't recompile on every pipeline
+		fprintf(stderr, "[mvk-madeira] on-demand library compile failed\n");
+		return false;
+	}
+	uint64_t n = ++sMadeiraLibsCompiledOnDemand;
+	if (n == 1 || n % 1000 == 0) { mvkMadeiraLogLibCounts("compile on demand"); }
+	return true;
+}
+
+// Madeira: releases the compiled library if it can be compiled again from stored MSL.
+void MVKShaderLibrary::madeiraDropMTLLibrary() {
+	if ( !_madeiraCanRecompile || !_mtlLibrary ) { return; }
+	[_mtlLibrary release];
+	_mtlLibrary = nil;
+	uint64_t n = ++sMadeiraLibsDropped;
+	if (n == 1 || n % 1000 == 0) { mvkMadeiraLogLibCounts("drop"); }
+}
