+#pragma mark - Madeira shader library dropping
+
+// Opt-in with the environment variable MADEIRA_MVK_DROP_SHADER_LIBRARIES=1 (any value except "0").
+// MoltenVK keeps a compiled MTLLibrary for every shader variant for as long as the pipeline
+// cache (or shader module) lives, and compiles every library in a saved pipeline cache as soon
+// as the cache is loaded. Games that build ~100,000 pipelines (Detroit: Become Human) run out
+// of memory that way on iOS. With dropping on, the MTLLibrary is released once a function has
+// been made from it, libraries read from a saved cache are compiled only when first needed, and
+// a dropped library is compiled again from its stored MSL if another pipeline needs it.
+static bool mvkMadeiraDropShaderLibraries() {
+	static const bool isEnabled = [] {
+		const char* val = getenv("MADEIRA_MVK_DROP_SHADER_LIBRARIES");
+		bool enabled = val && *val && strcmp(val, "0") != 0;
+		fprintf(stderr, "[mvk-madeira] shader library dropping %s (MADEIRA_MVK_DROP_SHADER_LIBRARIES=%s)\n",
+				enabled ? "ON" : "off", val ? val : "unset");
+		return enabled;
+	}();
+	return isEnabled;
+}
+
+static std::atomic<uint64_t> sMadeiraLibsDropped(0);
+static std::atomic<uint64_t> sMadeiraLibsCompiledOnDemand(0);
+static std::atomic<uint64_t> sMadeiraLibsDeferredAtLoad(0);
+
+static void mvkMadeiraLogLibCounts(const char* event) {
+	fprintf(stderr, "[mvk-madeira] libraries %s: dropped %llu, compiled on demand %llu, deferred at cache load %llu\n",
+			event,
+			(unsigned long long)sMadeiraLibsDropped.load(),
+			(unsigned long long)sMadeiraLibsCompiledOnDemand.load(),
+			(unsigned long long)sMadeiraLibsDeferredAtLoad.load());
+}
